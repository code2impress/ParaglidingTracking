# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git.

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFGGHHIIJJKKLLMMNN

# Secret key for the monitoring endpoint (anything random is fine)
MONITOR_SECRET=another-random-secret

# Your PythonAnywhere domain (no https://)
APP_DOMAIN=yourusername.pythonanywhere.com
